APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://factchecker:factchecker@postgres:5432/factchecker
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGIN=http://localhost:3000
MAX_INPUT_CHARS=50000
REQUEST_TIMEOUT_SECONDS=15
MAX_DOCUMENT_BYTES=5000000

SEARCH_PROVIDER=local
SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
SEARXNG_BASE_URL=
LOCAL_SEARCH_FIXTURE=/app/datasets/fixtures/search_results.json

ENABLE_NEURAL_MODELS=false
VERIFIER_MODEL=models/verifier
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VECTOR_DB=faiss
QDRANT_URL=http://qdrant:6333

MODEL_CONFIDENCE_THRESHOLD=0.70
MODEL_MARGIN_THRESHOLD=0.20
EVIDENCE_QUALITY_THRESHOLD=0.65
RATE_LIMIT_PER_MINUTE=20
CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=900
PAGE_CACHE_TTL_SECONDS=86400
FACT_CHECK_CACHE_TTL_SECONDS=3600
